# ==============================================================================
# MANTRA VOICE AGENT — SELF-HOSTED PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SELF-HOSTED LIVEKIT SERVER & AGENT CREDENTIALS
# ------------------------------------------------------------------------------
AGENT_NAME=mantra-agent-prod
LIVEKIT_ENTRYPOINT_TIMEOUT=40
# Use ws://host.docker.internal:7880 for Docker bridge mode, or ws://localhost:7880 for network_mode: host
LIVEKIT_URL=ws://host.docker.internal:7880
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_SIP_DOMAIN=tele-staging.mantracare.com

# Blank HTTPS_PROXY for self-hosted LiveKit local WS traffic
HTTPS_PROXY=
PLIVO_PROXY=

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL livekit_db)
# ------------------------------------------------------------------------------
# Use host.docker.internal for Docker bridge mode, or localhost for network_mode: host
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5440
POSTGRES_USER=redscarf
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=livekit_db

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Shared State & Queues)
# ------------------------------------------------------------------------------
# Use host.docker.internal:6379 for Docker bridge mode, or localhost:6379 for network_mode: host
REDIS_URL=redis://host.docker.internal:6379

# ------------------------------------------------------------------------------
# 4. CONCURRENCY & MEMORY SAFEGUARDS (Low-RAM VPS Optimization)
# ------------------------------------------------------------------------------
MAX_CONCURRENCY=2
LIVEKIT_MAX_ROOMS=2
AGENT_MAX_WORKERS=2

# PyTorch & NumPy Thread Caps (Prevents memory thread allocation spikes)
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# ------------------------------------------------------------------------------
# 5. AI ENGINES & API KEYS
# ------------------------------------------------------------------------------
# Speech-To-Text (Deepgram Nova-3)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Text-To-Speech (Cartesia sonic-3)
CARTESIA_API_KEY=your_cartesia_api_key_here

# LLM Reasoning Engines
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------------------
# 6. AWS S3 CONFIGURATION (Call Audio Recording Storage)
# ------------------------------------------------------------------------------
AWS_S3_BUCKET_NAME=mantra-livekit
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ------------------------------------------------------------------------------
# 7. BACKEND WEBHOOK & TELEMETRY INTEGRATION
# ------------------------------------------------------------------------------
MANTRAASSIST_BACKEND_URL=https://api.mantraassist.com
MANTRAASSIST_WEBHOOK_SECRET=your_webhook_secret_here
SERVER_HOST=0.0.0.0:8081

# ------------------------------------------------------------------------------
# 8. TELEPHONY PROVIDERS (Plivo / Zadarma / VoiceLink)
# ------------------------------------------------------------------------------
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
ZADARMA_API_KEY=your_zadarma_api_key_here
ZADARMA_SECRET=your_zadarma_secret_here

# ------------------------------------------------------------------------------
# 9. DASHBOARD SECURITY & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here
ADMIN_USERNAME_HASH=your_admin_username_hash_here
ADMIN_PASSWORD_HASH=your_admin_password_hash_here

# ------------------------------------------------------------------------------
# 10. OPENTELEMETRY METRICS & NO_PROXY
# ------------------------------------------------------------------------------
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_EXPORTER=none
NO_PROXY="livekit.cloud,api.deepgram.com,api.cartesia.ai,api.openai.com,api.deepseek.com,generativelanguage.googleapis.com"
