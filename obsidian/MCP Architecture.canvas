			"type": "text",
			"text": "🌐 **GET /api/v1/providers/availability**\n• Express.js / TypeScript REST Endpoint\n• Query params: `?org_id=68&date=2026-08-25&query=Sharma`\n• Returns JSON with doctor list and UTC slots",
			"fontSize": 12,
			"x": 650,
			"y": 240,
			"width": 340,
			"height": 160,
			"color": "#74b9ff"
		},
