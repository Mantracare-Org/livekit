			"type": "text",
			"text": "⚙️ **LiveKit MCP Server Core (:8000)**\n• Starlette ASGI + FastMCP Framework\n• Tool: `receive_doctor_availability`\n• Acts as Intelligent Gateway & Timezone Resolver",
			"fontSize": 12,
			"x": 650,
			"y": -320,
			"width": 340,
			"height": 180,
			"color": "#fab1a0"
		},
