			"id": "node-mcp-timezone",
			"type": "text",
			"text": "🌍 **International Timezone Engine**\n• Google `phonenumbers` + `zoneinfo`\n• Auto-detects caller country from phone (`+1`, `+91`, `+44`)\n• Converts raw UTC slots ➔ Local 12-hour voice format (EDT/IST)",
			"fontSize": 12,
			"x": 1020,
			"y": -320,
			"width": 350,
			"height": 180,
			"color": "#fab1a0"
		},
